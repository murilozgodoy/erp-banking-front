# Copie este arquivo para .env e ajuste os valores.
# Somente variáveis com prefixo VITE_ ficam disponíveis no front (e vão para o bundle:
# nunca coloque segredos aqui).

# URLs base dos microsserviços (sem barra no final). Portas iguais às abertas na EC2.
VITE_ONBOARDING_API_URL=http://localhost:8081
VITE_SCORE_API_URL=http://localhost:8082
VITE_TRANSACTIONS_API_URL=http://localhost:8080

# Timeout das requisições HTTP, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Auth0 (Application do tipo SPA). Domain e Client ID não são segredos.
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Identifier da API "ERP Banking API" no Auth0 (obrigatório): sem ele o Auth0 não emite
# o JWT que as APIs validam. Deve ser igual ao AUTH0_AUDIENCE dos backends.
VITE_AUTH0_AUDIENCE=https://erp-banking-api
