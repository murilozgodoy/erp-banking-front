# Copie este arquivo para .env e ajuste os valores.
# Somente variáveis com prefixo VITE_ ficam disponíveis no front (e vão para o bundle:
# nunca coloque segredos aqui).

# URLs base dos microsserviços (sem barra no final).
#
# 1) Local pelo API Gateway (docker compose do erp-banking-infra, porta 8080) — padrão:
VITE_ONBOARDING_API_URL=http://localhost:8080/onboarding
VITE_SCORE_API_URL=http://localhost:8080/score
VITE_TRANSACTIONS_API_URL=http://localhost:8080/transactions
#
# 2) Local sem gateway (cada API rodando direto na sua porta):
# VITE_ONBOARDING_API_URL=http://localhost:8081
# VITE_SCORE_API_URL=http://localhost:8082
# VITE_TRANSACTIONS_API_URL=http://localhost:8080
#
# 3) Produção na Vercel (rewrites do vercel.json levam /api/* ao gateway na EC2):
# VITE_ONBOARDING_API_URL=/api/onboarding
# VITE_SCORE_API_URL=/api/score
# VITE_TRANSACTIONS_API_URL=/api/transactions

# Base do API Gateway, usada só para o health do próprio gateway (`/gateway/health`).
# Opcional: vazio = o status do gateway não é exibido. Na Vercel use /api.
VITE_GATEWAY_URL=http://localhost:8080

# Links do monitoramento (opcionais; vazio = link escondido). Local: Grafana 8081 e Prometheus 8082.
# Na EC2 (3.235.6.136) o gateway fica na 8081, o Grafana na 8082 e o Prometheus não é exposto:
# VITE_GRAFANA_URL=http://3.235.6.136:8082  e  VITE_PROMETHEUS_URL= (vazio).
VITE_GRAFANA_URL=http://localhost:8081
VITE_PROMETHEUS_URL=http://localhost:8082

# Timeout das requisições HTTP, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Auth0 (Application do tipo SPA). Domain e Client ID não são segredos.
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Identifier da API "ERP Banking API" no Auth0 (obrigatório): sem ele o Auth0 não emite
# o JWT que as APIs validam. Deve ser igual ao AUTH0_AUDIENCE dos backends.
VITE_AUTH0_AUDIENCE=https://erp-banking-api
