# Copie este arquivo para .env e ajuste os valores.
# Somente variáveis com prefixo VITE_ ficam disponíveis no front (e vão para o bundle:
# nunca coloque segredos aqui).

# URLs base dos microsserviços (sem barra no final).
# Na Etapa 4, todas passam a apontar para o API Gateway.
VITE_ONBOARDING_API_URL=http://localhost:8001
VITE_SCORE_API_URL=http://localhost:8002
VITE_TRANSACTIONS_API_URL=http://localhost:8080

# Timeout das requisições HTTP, em milissegundos.
VITE_API_TIMEOUT_MS=10000
