{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/onboarding/:path*",
      "destination": "http://3.235.6.136:8081/onboarding/:path*"
    },
    {
      "source": "/api/score/:path*",
      "destination": "http://3.235.6.136:8081/score/:path*"
    },
    {
      "source": "/api/transactions/:path*",
      "destination": "http://3.235.6.136:8081/transactions/:path*"
    },
    {
      "source": "/api/gateway/:path*",
      "destination": "http://3.235.6.136:8081/gateway/:path*"
    },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
